{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1) Gerar dados",
      "type": "debugpy",
      "request": "launch",
      "module": "src.gerar_dados",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "2) Painel (interface)",
      "type": "debugpy",
      "request": "launch",
      "module": "src.main",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "3) Painel (relatório no terminal)",
      "type": "debugpy",
      "request": "launch",
      "module": "src.main",
      "args": ["--sem-interface"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "4) Testes (pytest)",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-v"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
